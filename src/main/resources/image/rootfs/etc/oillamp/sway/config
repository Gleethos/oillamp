# Configuration of sway, the sandbox's compositor.
#
# Read the last line before adding anything: this config runs as the `lamp` user, which owns the
# recording and the VNC server. A keybinding that runs a command would let anyone typing into the
# desktop execute it as `lamp`, and the agent can type into the desktop. That is the whole reason
# the agent and the compositor are different users.

include /run/lamp/output.conf
# `display.windows`: with "floating" this makes every window float, so it opens at the size the
# application asks for, moves by its title bar and resizes by its edges. With "tiling" it is empty
# and windows share the screen.
include /run/lamp/windows.conf
# The lamp itself, centred on the same colour the rest of the desktop uses. `center` rather than
# `stretch` so it looks right at any resolution the user configures. The image is transparent
# around its panel, so this fill colour is the dark surface the panel sits on. It is set here and
# nowhere else.
output * bg /usr/share/oillamp/wallpaper.png center #161a22

# Start Xwayland (the X11 server for Swing and other X11 applications) with sway and keep it
# running. With "enable", sway starts it on first use and stops it 10 seconds after the last X11
# client closes, and each new instance forgets the access the entrypoint grants the agent user.
xwayland force
# A border wide enough to grab with the mouse: a floating window resizes by dragging it.
default_border normal 4
default_floating_border normal 4

# Window frames in the wallpaper's colours: slate for everything at rest, and the lamp's brass
# only around the window that has the keyboard, so it is obvious where typing goes. The terminal
# (/etc/xdg/foot/foot.ini) uses the same palette.
#   surface #161a22, slate #1f2430, frame #2a303c, focused title #343b4a,
#   muted text #8e97ab, brass #c8913f, light bronze #e0b366, dark bronze #7a4d1c
#
# Each frame has two tones, like brass lit from above: a thin light outline around the title bar
# ("border" below) and a wider, darker border around the window's content ("frame" below). Sway
# gives every edge of a border the same colour and draws square corners; a bevel or rounded
# corners would need a different compositor.
font pango:DejaVu Sans 10
titlebar_padding 10 4
titlebar_border_thickness 2
#                       border  title   text    split   frame
client.focused          #e0b366 #343b4a #f3dfb0 #f3cf7e #7a4d1c
client.focused_inactive #3a4252 #2a303c #8e97ab #2a303c #2a303c
client.unfocused        #3a4252 #252a35 #8e97ab #2a303c #2a303c
client.urgent           #f0955a #e0703a #1f2430 #9c4a22 #9c4a22
client.placeholder      #1f2430 #1f2430 #8e97ab #1f2430 #1f2430
client.background       #1f2430
# Super+drag moves any floating window, Super+right-drag resizes it. A mouse binding, not a command.
floating_modifier Mod4 normal
focus_follows_mouse no
input * accel_profile flat

for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable

set $mod Mod4
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down
bindsym $mod+f     fullscreen toggle
bindsym $mod+space floating toggle
# For the user, on any window: Ctrl+Super with F for full screen, Q to close, M to minimize, and
# N to bring every minimized window back, where it was. `kill` asks the window to close, as its
# close button would; it signals no process. A minimized window waits on the workspace
# "minimized", which is never shown; the desktop shows workspace 1, which sway starts on. Not
# sway's scratchpad: there, bringing a window back is a toggle that a second press undoes.
# `[con_id=__focused__]` limits each to the window that has the keyboard: when the desktop itself
# has it, sway would close or minimize every window on it.
bindsym Ctrl+$mod+f [con_id=__focused__] fullscreen toggle
bindsym Ctrl+$mod+q [con_id=__focused__] kill
bindsym Ctrl+$mod+m [con_id=__focused__] move container to workspace minimized
bindsym Ctrl+$mod+n [workspace="^minimized$"] move container to workspace 1, focus

# NO exec, NO exit, NO reload bindings: keyboard input must never run commands as `lamp`.
# TheSandboxImageSpec checks this.
