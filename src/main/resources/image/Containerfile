# The sandbox image. See docs/ARCHITECTURE.md, "The container".
#
# Built once per content hash and then cached, so this file's *text* is part of the image
# identity: change a line and the next session rebuilds. Nothing here may depend on the host,
# the lamp directory or the session, because all three change without the hash changing.
#
# Layers are ordered slowest and least-changed first, so that editing rootfs/, which is what
# usually changes during development, re-runs only the last few steps.

ARG BASE_IMAGE=docker.io/library/debian:trixie
FROM ${BASE_IMAGE}

ARG JDK_PACKAGE=temurin-25-jdk
ARG NODE_MAJOR=24
# The harnesses the agent finds already installed. Named the way a user writes them in
# oillamp.toml; install-agent-tools.sh maps them to packages. Defaulted here as well as passed
# in, so an image built straight from this file is still usable out of the box.
ARG AGENT_TOOLS="opencode pi"
# pi extensions, installed at build time so they are there from the first session. The default
# adds Eden AI as a provider.
ARG PI_EXTENSIONS="git:github.com/edenai/pi-edenai"
ARG EXTRA_APT_PACKAGES=""
# When false, the JDK, Node and the agent tools are skipped. The desktop, SSH and the lamp
# tooling are all still there, and it builds much faster. The spike tests use this; oillamp itself
# always builds with the default.
ARG WITH_TOOLCHAIN=true

ENV DEBIAN_FRONTEND=noninteractive LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# ── base, locale, and the Adoptium repository ────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg locales \
 && sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
 && install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb trixie main" \
      > /etc/apt/sources.list.d/adoptium.list \
 && rm -rf /var/lib/apt/lists/*

# ── the shell an agent (and a person over ssh) actually expects to find ──────────────────────
# Not gated on WITH_TOOLCHAIN: these are small, and a sandbox without `ping`, an editor or a way
# to look at a process is a sandbox that feels broken rather than minimal. An agent that cannot
# diagnose its own environment burns its turns guessing instead.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash bash-completion coreutils util-linux procps psmisc less file tzdata \
      findutils diffutils patch grep sed gawk bc time \
      tar gzip bzip2 xz-utils zstd \
      iputils-ping iproute2 dnsutils traceroute netcat-openbsd \
      openssh-client rsync ca-certificates \
      vim nano htop tmux tree lsof man-db \
 && rm -rf /var/lib/apt/lists/*

# ── the desktop, SSH, and the tools `lamp` wraps ─────────────────────────────────────────────
# wlrctl is installed separately so that, if it is ever missing from Debian, the build still
# succeeds and only `lamp click`/`move`/`scroll` stop working. (It is in trixie today.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      sway xwayland x11-xserver-utils x11-utils wayvnc wf-recorder grim slurp wtype python3 \
      foot dbus dbus-x11 at-spi2-core xdg-utils \
      mesa-utils libgl1-mesa-dri libegl1 libgles2 \
      fonts-dejavu fonts-liberation2 fonts-noto-color-emoji adwaita-icon-theme \
      openssh-server socat catatonit \
 && (apt-get install -y --no-install-recommends wlrctl || echo "wlrctl unavailable: lamp click/move/scroll will not work") \
 && rm -rf /var/lib/apt/lists/*

# ── developer tooling, the part a user is most likely to want changed ────────────────────────
RUN if [ "${WITH_TOOLCHAIN}" = "true" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs wget unzip zip jq ripgrep fd-find build-essential cmake pkg-config gdb strace \
        python3 python3-venv python3-pip \
        firefox-esr libatk-wrapper-java \
        ${JDK_PACKAGE} ${EXTRA_APT_PACKAGES} \
      && rm -rf /var/lib/apt/lists/* ; \
    else \
      echo "WITH_TOOLCHAIN=false — skipping JDK, browser and build tools" ; \
    fi

COPY build/ /tmp/oillamp-build/
# The agent tooling and SDKMAN never fail the build (both scripts exit 0 whatever happens): a
# sandbox with no harness still has a desktop, a shell, a recording and a working ssh, and losing
# all of that because a registry was briefly unreachable would be a poor trade. Both install into
# /usr/local/share/oillamp, not into /home/agent, which is a bind mount that would hide them; the
# entrypoint seeds each into the home at session start.
RUN if [ "${WITH_TOOLCHAIN}" = "true" ]; then \
      /tmp/oillamp-build/install-node.sh "${NODE_MAJOR}" \
      && /tmp/oillamp-build/install-sdkman.sh \
      && PI_EXTENSIONS="${PI_EXTENSIONS}" /tmp/oillamp-build/install-agent-tools.sh ${AGENT_TOOLS} ; \
    fi \
 && rm -rf /tmp/oillamp-build

# ── the two users that separate the agent from the infrastructure ────────────────────────────
# agent (1000) is who the human's agent runs as. lamp (1001) runs the compositor, the VNC server
# and the recorder. The agent must not be able to signal lamp's processes or reach its sockets;
# that is what makes the recording trustworthy. The uid mapping that keeps them apart on the host
# is checked by VerifyingPodmanAssumptionsSpec.
RUN groupadd -g 1000 agent && useradd -u 1000 -g 1000 -d /home/agent -M -s /bin/bash agent \
 && groupadd -g 1001 lamp  && useradd -u 1001 -g 1001 -d /var/lib/lamp -M -s /usr/sbin/nologin lamp \
 && mkdir -p /oillamp/session /oillamp/sockets /oillamp/recordings /home/agent /var/lib/lamp \
 && chown lamp:lamp /var/lib/lamp

COPY rootfs/ /
RUN chmod 0755 /usr/local/lib/oillamp/entrypoint /usr/local/lib/oillamp/lamp-pointer /usr/local/bin/lamp

# Nothing in this image should be setuid: the sandbox's guarantees come from the user namespace,
# and a setuid binary inside it is a way for the agent to become `lamp`. Host keys are removed
# because the real one is generated per lamp and mounted in at session start.
RUN find / -xdev -perm /6000 -type f -exec chmod ug-s {} + \
 ; rm -f /etc/ssh/ssh_host_*

ENTRYPOINT ["/usr/local/lib/oillamp/entrypoint"]
